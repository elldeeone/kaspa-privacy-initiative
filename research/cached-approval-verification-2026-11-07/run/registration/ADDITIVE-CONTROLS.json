{
  "actualOnionTransport": true,
  "controls": [
    {
      "case": "unexpected human identity",
      "error": "unexpected issue field"
    },
    {
      "case": "unknown request kind",
      "error": "request kind"
    },
    {
      "case": "replayed eligibility",
      "error": "duplicate eligibility"
    },
    {
      "case": "altered new-claim wallet proof",
      "error": "invalid proof"
    },
    {
      "case": "changed valid recipient key",
      "error": "Verification failed"
    },
    {
      "case": "wrong round",
      "error": "round/issuer/denomination framing"
    },
    {
      "case": "wrong denomination",
      "error": "round/issuer/denomination framing"
    },
    {
      "case": "corrupted blind signature",
      "error": "Verification failed"
    },
    {
      "case": "replayed registered output",
      "error": "duplicate output"
    }
  ]
}
