      "error": "full:SignatureInvalid(ZkIntegrity(\"Groth16 verification failed\"))"
    },
    {
      "case": "changed actual payout key",
      "error": "full:SignatureInvalid(ZkIntegrity(\"Groth16 verification failed\"))"
    },
    {
      "case": "changed actual fee",
      "error": "full:SignatureInvalid(ZkIntegrity(\"Groth16 verification failed\"))"
    }
  ]
}