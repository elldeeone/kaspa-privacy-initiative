# Source-only proposal. Public synthetic numbers only; never a real witness.
# Stock MP-SPDZ MASCOT arithmetic over a fresh, exact BN254-Fr profile.
from Compiler.types import sint
from Compiler.library import break_point, print_ln_to

FR = 21888242871839275222246405745257275088548364400416034343698204186575808495617
assert len(program.args) == 2
run_id = program.args[1]
assert len(run_id) == 32 and all(c in '0123456789abcdef' for c in run_id)
assert int(program.options.prime) == FR
assert program.bit_length == 252

VECTORS = (
    ('zero', 0, 0, 0),
    ('one', 1, 1, 1),
    ('minus_one', FR - 1, FR - 1, FR - 1),
    ('wrap_add', FR - 1, 1, 0),
    ('wrap_mul', FR - 1, FR - 1, 1),
    ('small_mixed', 3, 7, 11),
    ('large_mixed', FR - 2, FR - 3, FR - 4),
)
residuals = sint.Array(28)
for index, (_, xa, ya, za) in enumerate(VECTORS):
    x = sint.get_input_from(0)
    y = sint.get_input_from(1)
    z = sint.get_input_from(2)
    xy = x * y
    # The next multiplication consumes an authenticated multiplication result.
    xyz = xy * z
    residuals[index * 4] = x + y - ((xa + ya) % FR)
    residuals[index * 4 + 1] = xy - ((xa * ya) % FR)
    residuals[index * 4 + 2] = xyz - ((xa * ya * za) % FR)
    residuals[index * 4 + 3] = (x + y) * (y + z) - (((xa + ya) * (ya + za)) % FR)

break_point('all-public-fixture-arithmetic-before-one-checked-opening')
opened = residuals.get_vector().reveal(check=True)
break_point('checked-opening-before-any-public-result')
for party in range(3):
    print_ln_to(party, 'KPI_FR_SCALAR_GATE ' + run_id)
    for index in range(28):
        print_ln_to(party, 'KPI_FR_RESIDUAL ' + str(index) + ' %s', opened[index])
