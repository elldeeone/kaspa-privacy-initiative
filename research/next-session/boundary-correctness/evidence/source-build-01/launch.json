    "--property=StandardError=file:/home/luke/projects/kpi-intensive-2026-10-22/boundary-runtime/source-build-01/stderr.log",
    "python3",
    "/home/luke/projects/kpi-intensive-2026-10-22/boundary-runtime/source-build-01/run.py"
