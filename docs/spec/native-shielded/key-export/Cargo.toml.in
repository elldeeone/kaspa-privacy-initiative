[package]
name = "kpi-native-key-export"
version = "0.1.0"
edition = "2021"
publish = false

[workspace]

[dependencies]
orchard = { path = "../sources/orchard", default-features = false, features = ["circuit", "multicore", "std", "zeroize", "verifier-fingerprint"] }
kpi-orchard-interop = { path = "@REPOSITORY@/poc/orchard-interop" }
sha2 = "0.10"
hex = "0.4"
serde_json = "1"

[patch.crates-io]
halo2_proofs = { path = "../sources/halo2_proofs" }

[patch."https://github.com/zcash/orchard"]
orchard = { path = "../sources/orchard" }
