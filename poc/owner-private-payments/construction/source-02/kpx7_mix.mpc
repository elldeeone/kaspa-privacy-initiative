# ADR0063: entire output tuples and beta sum in one malicious stock MPC session.
from Compiler.types import sint
from Compiler.library import break_point, print_ln_to

assert len(program.args) == 2
session_sha = program.args[1]
assert len(session_sha) == 64 and all(c in '0123456789abcdef' for c in session_sha)
rows = sint.Matrix(6, 17)
delta = sint(0)
for owner in range(3):
    for slot in range(2):
        for limb in range(17):
            rows[2 * owner + slot][limb] = sint.get_input_from(owner)
    delta += sint.get_input_from(owner)
break_point('all-complete-private-inputs-before-stock-shuffle')
rows.secure_shuffle()
break_point('whole-row-shuffle-before-checked-public-output')
opened = rows.get_vector().reveal(check=True)
aggregate = delta.reveal(check=True)
for party in range(3):
    print_ln_to(party, 'KPX7_SESSION ' + session_sha)
    for row in range(6):
        print_ln_to(party, 'KPX7_ROW ' + str(row) + ' ' + ' '.join(['%s'] * 17),
                    *[opened[row * 17 + limb] for limb in range(17)])
    print_ln_to(party, 'KPX7_DELTA %s', aggregate)
