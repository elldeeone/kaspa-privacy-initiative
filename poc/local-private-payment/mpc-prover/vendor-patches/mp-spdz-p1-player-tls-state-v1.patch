+#pragma once
+
+// KPI source hook for the exact passive-P1 TLS construction prefix. This is
+// private evidence transport only. It deliberately does not claim that the
+// OpenSSL provider DRBG, record-layer buffers, or every traffic-key epoch is
+// reconstructible from these callbacks.
+
+#include "p1_player_tls_state_hook.hpp"
+
+#include <openssl/crypto.h>
+#include <openssl/evp.h>
+#include <openssl/pem.h>
+#include <openssl/ssl.h>
+#include <openssl/x509.h>
+
+#include <array>
+#include <cstdint>
+#include <cstring>
+#include <span>
+#include <string>
+#include <vector>
+
+namespace kpb_mp_spdz_p1_tls {
+
+using Hook = kpi::mpc::p1_private_state::PlayerTlsStateHook;
+using Event = kpi::mpc::p1_private_state::PlayerTlsEventView;
+using Kind = kpi::mpc::p1_private_state::PlayerTlsEventKind;
+using Bytes = std::vector<unsigned char>;
+
+inline void cleanse(Bytes& value) noexcept {
+    if (!value.empty()) OPENSSL_cleanse(value.data(), value.size());
+    value.clear();
+}
+
+inline Bytes x509_der(X509* value) {
+    if (value == nullptr) throw std::runtime_error("missing-TLS-certificate");
+    const int count = i2d_X509(value, nullptr);
+    if (count <= 0) throw std::runtime_error("invalid-TLS-certificate-DER");
+    Bytes result(static_cast<std::size_t>(count));
+    auto* output = result.data();
+    if (i2d_X509(value, &output) != count ||
+        output != result.data() + result.size())
+        throw std::runtime_error("incomplete-TLS-certificate-DER");
+    return result;
+}
+
+inline Bytes private_key_der(EVP_PKEY* value) {
+    if (value == nullptr) throw std::runtime_error("missing-TLS-private-key");
+    const int count = i2d_PrivateKey(value, nullptr);
+    if (count <= 0) throw std::runtime_error("invalid-TLS-private-key-DER");
+    Bytes result(static_cast<std::size_t>(count));
+    auto* output = result.data();
+    if (i2d_PrivateKey(value, &output) != count ||
+        output != result.data() + result.size()) {
+        cleanse(result);
+        throw std::runtime_error("incomplete-TLS-private-key-DER");
+    }
+    return result;
+}
+
+inline void append_u64(Bytes& output, std::uint64_t value) {
+    for (int shift = 56; shift >= 0; shift -= 8)
+        output.push_back(static_cast<unsigned char>(value >> shift));
+}
+
+inline Bytes verified_chain_der(SSL* ssl) {
+    STACK_OF(X509)* chain = SSL_get0_verified_chain(ssl);
+    if (chain == nullptr || sk_X509_num(chain) <= 0)
+        throw std::runtime_error("missing-TLS-verified-chain");
+    Bytes result;
+    append_u64(result, static_cast<std::uint64_t>(sk_X509_num(chain)));
+    for (int index = 0; index < sk_X509_num(chain); ++index) {
+        auto der = x509_der(sk_X509_value(chain, index));
+        append_u64(result, der.size());
+        result.insert(result.end(), der.begin(), der.end());
+    }
+    return result;
+}
+
+inline void context_loaded(
+        SSL_CTX* context, Hook* hook, std::uint64_t role,
+        std::uint64_t players, std::string_view player_id) {
+    if (hook == nullptr) return;
+    Bytes certificate;
+    Bytes private_key;
+    try {
+        certificate = x509_der(SSL_CTX_get0_certificate(context));
+        private_key = private_key_der(SSL_CTX_get0_privatekey(context));
+        Event event{};
+        event.kind = Kind::TlsContextLoaded;
+        event.local_role = role;
+        event.player_count = players;
+        event.player_id = player_id;
+        event.payloads[0] = certificate;
+        event.payloads[1] = private_key;
+        if (!hook->record_player_tls_event(event))
+            throw std::runtime_error("P1-TLS-context-capture-failed");
+        cleanse(private_key);
+    } catch (...) {
+        cleanse(private_key);
+        hook->player_tls_unavailable_noexcept();
+        throw;
+    }
+}
+
+class ChannelCapture final {
+    Hook* hook_{};
+    std::uint64_t role_{};
+    std::uint64_t players_{};
+    std::uint64_t peer_{};
+    std::uint64_t lane_{};
+    bool client_{};
+    std::string player_id_;
+    bool unavailable_{};
+    SSL* ssl_{};
+
+    static int ex_index() {
+        static const int value = SSL_get_ex_new_index(0, nullptr, nullptr,
+                                                       nullptr, nullptr);
+        return value;
+    }
+
+    Event event(Kind kind) const {
+        Event result{};
+        result.kind = kind;
+        result.local_role = role_;
+        result.player_count = players_;
+        result.peer_role = peer_;
+        result.lane = lane_;
+        result.client = client_ ? 1 : 0;
+        result.player_id = player_id_;
+        return result;
+    }
+
+    bool record(const Event& value) noexcept {
+        if (hook_ == nullptr) return true;
+        if (unavailable_ || !hook_->record_player_tls_event(value)) {
+            unavailable();
+            return false;
+        }
+        return true;
+    }
+
+    static ChannelCapture* from_ssl(const SSL* ssl) noexcept {
+        const int index = ex_index();
+        if (index < 0) return nullptr;
+        return static_cast<ChannelCapture*>(
+            SSL_get_ex_data(const_cast<SSL*>(ssl), index));
+    }
+
+    static void info_callback(const SSL* ssl, int where, int result) {
+        auto* self = from_ssl(ssl);
+        if (self == nullptr || self->hook_ == nullptr) return;
+        auto value = self->event(Kind::TlsInfo);
+        value.info_where = static_cast<std::uint32_t>(where);
+        value.info_return = static_cast<std::uint32_t>(result);
+        value.ssl_state = static_cast<std::uint64_t>(SSL_get_state(ssl));
+        value.shutdown_state = static_cast<std::uint32_t>(
+            SSL_get_shutdown(ssl));
+        self->record(value);
+    }
+
+    static void message_callback(
+            int write_direction, int version, int content_type,
+            const void* bytes, std::size_t count, SSL* ssl, void* argument) {
+        auto* self = static_cast<ChannelCapture*>(argument);
+        if (self == nullptr) self = from_ssl(ssl);
+        if (self == nullptr || self->hook_ == nullptr ||
+            bytes == nullptr || count == 0) {
+            if (self != nullptr) self->unavailable();
+            return;
+        }
+        auto value = self->event(Kind::TlsMessage);
+        value.write_direction = write_direction != 0;
+        value.protocol_version = static_cast<std::uint32_t>(version);
+        value.content_type = static_cast<std::uint32_t>(content_type);
+        value.ssl_state = static_cast<std::uint64_t>(SSL_get_state(ssl));
+        value.shutdown_state = static_cast<std::uint32_t>(
+            SSL_get_shutdown(ssl));
+        value.payloads[0] = std::span(
+            static_cast<const unsigned char*>(bytes), count);
+        self->record(value);
+    }
+
+    static void keylog_callback(const SSL* ssl, const char* line) {
+        auto* self = from_ssl(ssl);
+        if (self == nullptr || self->hook_ == nullptr || line == nullptr) {
+            if (self != nullptr) self->unavailable();
+            return;
+        }
+        const auto count = std::strlen(line);
+        if (count == 0) {
+            self->unavailable();
+            return;
+        }
+        auto value = self->event(Kind::TlsKeyLog);
+        value.payloads[0] = std::span(
+            reinterpret_cast<const unsigned char*>(line), count);
+        self->record(value);
+    }
+
+public:
+    ChannelCapture(
+            Hook* hook, std::uint64_t role, std::uint64_t players,
+            std::uint64_t peer, std::uint64_t lane, bool client,
+            std::string player_id)
+        : hook_(hook), role_(role), players_(players), peer_(peer),
+          lane_(lane), client_(client), player_id_(std::move(player_id)) {}
+
+    ~ChannelCapture() {
+        if (ssl_ == nullptr) return;
+        const int index = ex_index();
+        SSL_set_info_callback(ssl_, nullptr);
+        SSL_set_msg_callback(ssl_, nullptr);
+        SSL_set_msg_callback_arg(ssl_, nullptr);
+        if (index >= 0) (void)SSL_set_ex_data(ssl_, index, nullptr);
+    }
+
+    void unavailable() noexcept {
+        if (unavailable_) return;
+        unavailable_ = true;
+        if (hook_ != nullptr) hook_->player_tls_unavailable_noexcept();
+    }
+
+    void install(SSL* ssl) {
+        if (hook_ == nullptr) return;
+        const int index = ex_index();
+        if (ssl == nullptr || index < 0 ||
+            SSL_set_ex_data(ssl, index, this) != 1)
+            throw std::runtime_error("P1-TLS-callback-install-failed");
+        ssl_ = ssl;
+        SSL_set_info_callback(ssl, info_callback);
+        SSL_set_msg_callback(ssl, message_callback);
+        SSL_set_msg_callback_arg(ssl, this);
+        SSL_CTX_set_keylog_callback(SSL_get_SSL_CTX(ssl), keylog_callback);
+        if (!record(event(Kind::TlsChannelStarted)))
+            throw std::runtime_error("P1-TLS-channel-start-capture-failed");
+    }
+
+    void handshake_failed(SSL* ssl, std::string_view failure) noexcept {
+        if (hook_ == nullptr) return;
+        auto value = event(Kind::TlsHandshakeFailed);
+        value.ssl_state = ssl == nullptr ? 0 :
+            static_cast<std::uint64_t>(SSL_get_state(ssl));
+        value.shutdown_state = ssl == nullptr ? 0 :
+            static_cast<std::uint32_t>(SSL_get_shutdown(ssl));
+        value.failure_class = failure.empty() ?
+            std::string_view("unknown-TLS-handshake-failure") : failure;
+        (void)record(value);
+    }
+
+    void handshake_complete(SSL* ssl) {
+        if (hook_ == nullptr) return;
+        std::array<Bytes, 6> payloads;
+        try {
+            if (ssl == nullptr || unavailable_)
+                throw std::runtime_error("unavailable-P1-TLS-channel");
+            payloads[0].resize(SSL_get_client_random(ssl, nullptr, 0));
+            payloads[1].resize(SSL_get_server_random(ssl, nullptr, 0));
+            if (payloads[0].empty() || payloads[1].empty() ||
+                SSL_get_client_random(
+                    ssl, payloads[0].data(), payloads[0].size()) !=
+                    payloads[0].size() ||
+                SSL_get_server_random(
+                    ssl, payloads[1].data(), payloads[1].size()) !=
+                    payloads[1].size())
+                throw std::runtime_error("missing-P1-TLS-randoms");
+            SSL_SESSION* session = SSL_get_session(ssl);
+            if (session == nullptr)
+                throw std::runtime_error("missing-P1-TLS-session");
+            payloads[2].resize(
+                SSL_SESSION_get_master_key(session, nullptr, 0));
+            if (payloads[2].empty() ||
+                SSL_SESSION_get_master_key(
+                    session, payloads[2].data(), payloads[2].size()) !=
+                    payloads[2].size())
+                throw std::runtime_error("missing-P1-TLS-master-key");
+            unsigned session_id_count = 0;
+            const auto* session_id = SSL_SESSION_get_id(
+                session, &session_id_count);
+            if (session_id_count != 0) {
+                if (session_id == nullptr)
+                    throw std::runtime_error("missing-P1-TLS-session-id");
+                payloads[3].assign(
+                    session_id, session_id + session_id_count);
+            }
+            payloads[4] = x509_der(SSL_get_certificate(ssl));
+            payloads[5] = verified_chain_der(ssl);
+            const char* protocol = SSL_get_version(ssl);
+            const char* cipher = SSL_get_cipher_name(ssl);
+            if (protocol == nullptr || cipher == nullptr)
+                throw std::runtime_error("missing-P1-TLS-negotiation");
+            auto value = event(Kind::TlsHandshakeComplete);
+            value.protocol_name = protocol;
+            value.cipher_name = cipher;
+            value.verify_result = static_cast<std::uint64_t>(
+                SSL_get_verify_result(ssl));
+            value.ssl_state = static_cast<std::uint64_t>(SSL_get_state(ssl));
+            value.shutdown_state = static_cast<std::uint32_t>(
+                SSL_get_shutdown(ssl));
+            for (std::size_t index = 0; index < payloads.size(); ++index)
+                value.payloads[index] = payloads[index];
+            if (!record(value))
+                throw std::runtime_error("P1-TLS-terminal-capture-failed");
+            for (auto& payload : payloads) cleanse(payload);
+        } catch (...) {
+            for (auto& payload : payloads) cleanse(payload);
+            unavailable();
+            throw;
+        }
+    }
+};
+
+} // namespace kpb_mp_spdz_p1_tls
