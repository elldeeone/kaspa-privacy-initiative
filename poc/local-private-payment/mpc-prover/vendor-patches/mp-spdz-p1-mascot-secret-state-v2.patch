 template<class T>
+void OTTripleGenerator<T>::stop_and_join_multipliers() noexcept
+{
+    for (auto multiplier : ot_multipliers)
+        if (multiplier != 0 && multiplier->p1_mascot_thread_created)
+            multiplier->inbox.stop();
+    for (size_t i = 0; i < ot_multipliers.size(); i++)
+    {
+        auto multiplier = ot_multipliers[i];
+        if (multiplier == 0 || not multiplier->p1_mascot_thread_created)
+            continue;
+        int join_result = pthread_join(multiplier->thread, NULL);
+        if (join_result == 0 && multiplier->p1_mascot_capture)
+            kpi::mpc::p1_private_state::MascotSecretStateSourceBridge::
+                ot_worker_joined_noexcept(
+                    multiplier, multiplier->p1_mascot_worker_epoch);
+        else if (join_result != 0 && multiplier->p1_mascot_capture)
+            kpi::mpc::p1_private_state::MascotSecretStateSourceBridge::
+                unavailable_noexcept();
+        multiplier->p1_mascot_thread_created = false;
+#ifdef DEBUG_THREADS
+        cout << "OT thread " << i << " finished\n" << flush;
+#endif
+    }
+}
