# ADR0065: stock malicious MASCOT with independent joint random-key sorts.
# Financial statements, proofs and native effects remain checked downstream.
from Compiler.types import sint
from Compiler.library import break_point, print_ln_to, runtime_error_if

assert len(program.args) == 4
sid, stage, effects = program.args[1:]
assert len(sid) == len(effects) == 64
assert all(c in '0123456789abcdef' for c in sid + effects)
assert stage in ('admit', 'authorize')
assert stage != 'admit' or effects == '0' * 64


def keyed(rows, count, limbs):
    result = sint.Matrix(count, limbs + 1)
    for row in range(count):
        for limb in range(limbs):
            result[row][limb + 1] = rows[row][limb]
    for row in range(count):
        result[row][0] = sint.get_random_int(128)
    collision = sint(0)
    for left in range(count):
        for right in range(left + 1, count):
            equal = result[left][0].equal(result[right][0], bit_length=128)
            collision = 1 - (1 - collision) * (1 - equal)
    return result, collision


def sort_rows(rows):
    # Compare only joint-key column0; move every complete record together.
    rows.sort(key_indices=(0,), batcher=True)


if stage == 'admit':
    inputs = sint.Matrix(3, 4)
    outputs = sint.Matrix(6, 17)
    delta = sint(0)
    for owner in range(3):
        for limb in range(4):
            inputs[owner][limb] = sint.get_input_from(owner)
        for slot in range(2):
            for limb in range(17):
                outputs[2 * owner + slot][limb] = sint.get_input_from(owner)
        delta += sint.get_input_from(owner)
    break_point('all-private-records-before-joint-random-keys')
    program.set_bit_length(128)
    mixed_inputs, input_collision = keyed(inputs, 3, 4)
    mixed_outputs, output_collision = keyed(outputs, 6, 17)
    collision = 1 - (1 - input_collision) * (1 - output_collision)
    collision_public = collision.reveal(check=True)
    break_point('checked-global-key-collision-before-any-record-opening')
    runtime_error_if(collision_public, 'KPX9_KEY_COLLISION_NEW_SESSION_REQUIRED')
    sort_rows(mixed_inputs)
    sort_rows(mixed_outputs)
    complete = sint.Array(115)
    for row in range(3):
        for limb in range(4):
            complete[row * 4 + limb] = mixed_inputs[row][limb + 1]
    for row in range(6):
        for limb in range(17):
            complete[12 + row * 17 + limb] = mixed_outputs[row][limb + 1]
    complete[114] = delta
    break_point('all-sorts-before-one-checked-projection-opening')
    opened = complete.get_vector().reveal(check=True)
    for party in range(3):
        print_ln_to(party, 'KPX9_SESSION ' + sid)
        print_ln_to(party, 'KPX9_PHASE ' + stage)
        print_ln_to(party, 'KPX9_EFFECTS ' + effects)
        for row in range(3):
            print_ln_to(party, 'KPX9_INPUT ' + str(row) + ' ' + ' '.join(['%s'] * 4),
                        *[opened[row * 4 + limb] for limb in range(4)])
        for row in range(6):
            print_ln_to(party, 'KPX9_OUTPUT ' + str(row) + ' ' + ' '.join(['%s'] * 17),
                        *[opened[12 + row * 17 + limb] for limb in range(17)])
        print_ln_to(party, 'KPX9_DELTA %s', opened[114])
else:
    authorizations = sint.Matrix(3, 8)
    for owner in range(3):
        for limb in range(8):
            authorizations[owner][limb] = sint.get_input_from(owner)
    break_point('all-private-authorizations-before-new-joint-random-keys')
    program.set_bit_length(128)
    mixed, collision = keyed(authorizations, 3, 8)
    collision_public = collision.reveal(check=True)
    break_point('checked-authorization-key-collision-before-record-opening')
    runtime_error_if(collision_public, 'KPX9_KEY_COLLISION_NEW_SESSION_REQUIRED')
    sort_rows(mixed)
    complete = sint.Array(24)
    for row in range(3):
        for limb in range(8):
            complete[row * 8 + limb] = mixed[row][limb + 1]
    opened = complete.get_vector().reveal(check=True)
    for party in range(3):
        print_ln_to(party, 'KPX9_SESSION ' + sid)
        print_ln_to(party, 'KPX9_PHASE ' + stage)
        print_ln_to(party, 'KPX9_EFFECTS ' + effects)
        for row in range(3):
            print_ln_to(party, 'KPX9_AUTH ' + str(row) + ' ' + ' '.join(['%s'] * 8),
                        *[opened[row * 8 + limb] for limb in range(8)])
